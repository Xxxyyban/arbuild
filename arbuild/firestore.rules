rules_version = '2';

// ARBuild Firestore security rules.
// Publish in the Firebase console (Firestore Database > Rules), or with `firebase deploy --only firestore:rules`.
//
// Principles: deny by default; every write is checked against who is signing in; people can only
// write their own things; counters only move by one, alongside the change they count; timestamps
// are the server's; anything shown with a name or a badge can't be faked.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------

    // Signed in, with a profile the admin hasn't turned off. A sign-in alone isn't enough: a deleted
    // account's sign-in still works (only the Firebase console removes it), and an inactive one's too.
    function signedIn() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('status', 'active') != 'inactive';
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function profileOf(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    // Admin = the signed-in user's profile has role "admin"
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && profileOf(request.auth.uid).role == 'admin';
    }

    // Faculty = the signed-in user's profile has role "faculty"
    function isFaculty() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && profileOf(request.auth.uid).role == 'faculty';
    }

    // Instructors can run labs and classes: faculty and admins
    function isInstructor() {
      return isFaculty() || isAdmin();
    }

    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Only these fields change in this update
    function onlyChanges(keys) {
      return changed().hasOnly(keys);
    }

    // A short piece of text: a string of 1..max characters
    function text(v, max) {
      return v is string && v.size() > 0 && v.size() <= max;
    }

    // A string of up to max characters, empty too
    function upTo(v, max) {
      return v is string && v.size() <= max;
    }

    // v is the signed-in person's name as their profile has it (first and last), or their email when
    // the profile has no name
    function isMyName(v) {
      let p = profileOf(request.auth.uid);
      let n = (p.get('firstName', '') + ' ' + p.get('lastName', '')).trim();
      return (n.size() > 0 && v == n) || (n.size() == 0 && v == request.auth.token.email);
    }

    // Fields a student/faculty must NOT be able to change on their own profile. Once the profile is
    // set up, the student ID and section are fixed too (only the admin changes them), so nobody can
    // take another student's ID.
    function lockedFieldsUntouched() {
      return !changed().hasAny(['role', 'status', 'email', 'uid', 'createdAt', 'createdBy', 'lastNotifiedAt'])
        && (resource.data.get('profileCompleted', false) != true
            || !changed().hasAny(['studentId', 'section', 'profileCompleted']));
    }

    // Finishing setup (profileCompleted turning true) takes the person's agreement to the Data Privacy
    // Notice and the Terms of Use: consent = { privacy, terms } (the versions they agreed to, from
    // src/lab/Policies.js), timed by the server. Once set up, only the admin changes it.
    function consentOnSetup() {
      let done = resource.data.get('profileCompleted', false) == true;
      let finishing = !done && request.resource.data.get('profileCompleted', false) == true;
      return (done && !changed().hasAny(['consent']))
        || (!done && !finishing)
        || (finishing
            && text(request.resource.data.consent.privacy, 40)
            && text(request.resource.data.consent.terms, 40)
            && request.resource.data.consent.at == request.time);
    }

    // ---------- lab-session helpers ----------

    // Running and not past its time. A lab runs until the instructor closes it (expiresAt is
    // null); older labs saved with a countdown still stop when expiresAt passes.
    function running(s) {
      return s.status == 'running'
        && (s.get('expiresAt', null) == null || request.time < s.expiresAt);
    }

    // Waiting for the instructor to start, or running
    function sessionAlive(code) {
      let s = get(/databases/$(database)/documents/sessions/$(code)).data;
      return s.status == 'waiting' || running(s);
    }

    function sessionRunning(code) {
      return running(get(/databases/$(database)/documents/sessions/$(code)).data);
    }

    // Closed by the instructor within the last minute (closedAt is the server's time). A student's
    // lab saves its progress every half minute, not at every step, so its last steps may not be in
    // yet: it sends the final result as the lab closes, and that one still gets in.
    function sessionJustClosed(code) {
      let s = get(/databases/$(database)/documents/sessions/$(code)).data;
      return s.status == 'closed'
        && s.get('closedAt', null) is timestamp
        && request.time < s.closedAt + duration.value(60, 's');
    }

    // The instructor who created the session, or an admin
    function ownsSession(code) {
      return signedIn()
        && (get(/databases/$(database)/documents/sessions/$(code)).data.instructorUid == request.auth.uid
            || isAdmin());
    }

    // ---------- profiles ----------

    match /users/{uid} {
      // your own, even when inactive: the app reads it to tell you so
      allow read: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isOwner(uid) && lockedFieldsUntouched() && consentOnSetup());
    }

    match /students/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isOwner(uid) && lockedFieldsUntouched() && consentOnSetup());
    }

    match /faculty/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isOwner(uid) && lockedFieldsUntouched() && consentOnSetup());
    }

    // ---------- profile cards (src/lab/People.js) ----------

    // An instructor's card: what their students see of them, exactly as their own profile has it.
    // Anyone signed in can look one up by its uid (an instructor's name is on every class they
    // teach); nobody can list them. A student's card is their member record in each class (below).
    match /instructors/{uid} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if isOwner(uid) && isInstructor()
        && request.resource.data.keys().hasOnly(['uid', 'name', 'department', 'email', 'photo', 'updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.name == (profileOf(uid).get('firstName', '') + ' ' + profileOf(uid).get('lastName', '')).trim()
        && request.resource.data.name.size() > 0
        && request.resource.data.department == profileOf(uid).get('department', '')
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.photo == profileOf(uid).get('photoThumb', '')
        && request.resource.data.photo.size() <= 40000
        && request.resource.data.updatedAt == request.time;
      allow delete: if isOwner(uid) || isAdmin();
    }

    // ---------- announcements (src/lab/Announcements.js) ----------

    // The admin's announcements, to everyone, to students or to instructors: each person reads only
    // the ones meant for them. Only the admin posts one (as themselves, timed by the server) or
    // removes one; nobody edits one. It goes out under their name, or as "ARBuild Admin" when their
    // account has no name: not under their sign-in email, which the whole school would read.
    match /announcements/{audience}/items/{id} {
      function forMe() {
        return audience == 'all'
          || (audience == 'students' && profileOf(request.auth.uid).role == 'student')
          || (audience == 'faculty' && profileOf(request.auth.uid).role == 'faculty');
      }
      allow read: if isAdmin() || (signedIn() && forMe());
      allow create: if isAdmin()
        && audience in ['all', 'students', 'faculty']
        && request.resource.data.keys().hasOnly(['title', 'body', 'byUid', 'byName', 'createdAt'])
        && text(request.resource.data.title, 120)
        && upTo(request.resource.data.body, 2000)
        && request.resource.data.byUid == request.auth.uid
        && (request.resource.data.byName == 'ARBuild Admin' || isMyName(request.resource.data.byName))
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ---------- notifications ----------

    match /notifications/{id} {
      // admin: full control. user: read their own, and may only flip "read".
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid && onlyChanges(['read']));
    }

    // ---------- lab activities (Build Lab sessions) ----------

    match /sessions/{code} {
      // A student can look up one code; instructors list only their own labs.
      allow get: if signedIn();
      allow list: if signedIn() && (resource.data.instructorUid == request.auth.uid || isAdmin());

      allow create: if isInstructor() && request.resource.data.instructorUid == request.auth.uid;
      allow update: if ownsSession(code) && request.resource.data.instructorUid == resource.data.instructorUid;
      allow delete: if ownsSession(code);

      // One row per student. A student writes only their own row while the lab is alive (and its
      // final result, in the minute after it closes), and
      // can never set the task the instructor assigned. Their official score is a whole number,
      // out of the task's points (scoreScale, at most 100), never above it. The instructor can
      // write any row. (Screens read the task's points from the lab itself, not from this row.)
      match /students/{uid} {
        function validScore() {
          let d = request.resource.data;
          let scale = d.get('scoreScale', 100);
          return scale is int && scale >= 1 && scale <= 100
            && (!('score' in d) || (d.score is int && d.score >= 0 && d.score <= scale));
        }

        allow read: if isOwner(uid) || ownsSession(code);
        allow create: if isOwner(uid) && sessionAlive(code)
          && !request.resource.data.keys().hasAny(['assignedTask', 'assignedMode', 'assignedAt'])
          && validScore();
        allow update: if ownsSession(code)
          || (isOwner(uid) && (sessionAlive(code) || sessionJustClosed(code))
              && !changed().hasAny(['assignedTask', 'assignedMode', 'assignedAt', 'uid'])
              && (!changed().hasAny(['score', 'scoreScale']) || validScore()));
        allow delete: if ownsSession(code);
      }

      // Mistake log. Students add their own events (small ones), only the instructor reads them.
      // Only the fields the lab writes (lab/reportEvent.js, lab/useLabSession.js sink), each kept small,
      // so nobody can fill the instructor's Common mistakes view with huge entries.
      match /events/{eventId} {
        allow read: if ownsSession(code);
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'ts', 'mode', 'type', 'part', 'detail', 'points'])
          && upTo(request.resource.data.get('mode', ''), 20)
          && upTo(request.resource.data.get('type', ''), 20)
          && upTo(request.resource.data.get('part', ''), 80)
          && upTo(request.resource.data.get('detail', ''), 1000)
          && request.resource.data.get('ts', 0) is number
          && request.resource.data.get('points', 0) is number
          && sessionRunning(code);
      }
    }

    // ---------- classes ----------
    //   classCodes/{code}                     finds a class from its join code
    //   classes/{classId}                     the class (instructor, code, name...)
    //     members/{uid}                       students in it
    //     removed/{uid}                       students the instructor took out (they can't come back alone)
    //     log/{id}                            the class's record: removals, readmissions, ending, reopening
    //     posts/{postId}, .../comments/{id}   stream: announcements, materials, lab activities
    //   userClasses/{uid}/classes/{classId}   each student's own list of classes
    // Students can't leave on their own: only the class's instructor takes a student out, and every
    // removal, readmission, ending and reopening is written in the record in the same write, with the
    // server's time. Nobody, the admin neither, changes or deletes a line of the record. An ended
    // (archived) class is a read-only record: nobody joins, posts or comments.

    // A code can be read one at a time (to join), never listed, and only points at your own class.
    match /classCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if isInstructor()
        && request.resource.data.instructorUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data.instructorUid == request.auth.uid;
      allow update: if false;
      allow delete: if signedIn() && resource.data.instructorUid == request.auth.uid;
    }

    match /classes/{classId} {
      function classDoc() {
        return get(/databases/$(database)/documents/classes/$(classId)).data;
      }
      function teaches() {
        return signedIn() && (classDoc().instructorUid == request.auth.uid || isAdmin());
      }
      function memberPath(uid) {
        return /databases/$(database)/documents/classes/$(classId)/members/$(uid);
      }
      function member() {
        return signedIn() && exists(memberPath(request.auth.uid));
      }
      function removedPath(uid) {
        return /databases/$(database)/documents/classes/$(classId)/removed/$(uid);
      }
      function logPath(id) {
        return /databases/$(database)/documents/classes/$(classId)/log/$(id);
      }
      function ended() {
        return classDoc().get('archived', false) == true;
      }
      // the head count goes up by one, in the same write as the student joining (only the instructor
      // takes students out, and lowers it then)
      function joining() {
        return onlyChanges(['studentCount'])
          && request.resource.data.studentCount == resource.data.studentCount + 1
          && !exists(memberPath(request.auth.uid)) && existsAfter(memberPath(request.auth.uid));
      }
      // ending or reopening the class, with its line in the record (logId) written alongside
      function endingOrReopening() {
        let d = request.resource.data;
        return d.get('logId', null) is string
          && getAfter(logPath(d.logId)).data.at == request.time
          && ((d.archived == true && d.get('endedAt', null) == request.time
                && getAfter(logPath(d.logId)).data.type == 'ended')
              || (d.archived == false && d.get('endedAt', null) == null
                && getAfter(logPath(d.logId)).data.type == 'reopened'));
      }

      // name and code are shown to a student joining with the code
      allow get: if signedIn();
      allow list: if signedIn() && (resource.data.instructorUid == request.auth.uid || isAdmin());
      allow create: if isInstructor()
        && request.resource.data.instructorUid == request.auth.uid
        && request.resource.data.studentCount == 0;
      allow update: if (signedIn() && (resource.data.instructorUid == request.auth.uid || isAdmin())
                        && request.resource.data.instructorUid == resource.data.instructorUid
                        && (!changed().hasAny(['archived', 'endedAt']) || endingOrReopening()))
        || (signedIn() && joining());
      allow delete: if signedIn() && (resource.data.instructorUid == request.auth.uid || isAdmin());

      match /members/{uid} {
        // the student's card, which only the class's instructor sees: name, ID, section, contact
        // number and photo, exactly as their own profile has them
        function cardFromProfile() {
          let p = profileOf(uid);
          let d = request.resource.data;
          return d.name == (p.get('firstName', '') + ' ' + p.get('lastName', '')).trim()
            && d.studentId == p.get('studentId', '')
            && d.section == p.get('section', '')
            && d.get('contactNumber', '') == p.get('contactNumber', '')
            && d.get('photo', '') == p.get('photoThumb', '')
            && d.get('photo', '').size() <= 40000;
        }

        allow get: if isOwner(uid) || teaches();
        allow list: if teaches();
        // join yourself, as yourself (your card and email from your own profile), while the class
        // takes new students, unless its instructor took you out (then only they can let you back)
        allow create: if isOwner(uid)
          && classDoc().get('joinOpen', true) != false
          && !ended()
          && !exists(removedPath(uid))
          && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'studentId', 'section', 'contactNumber', 'photo', 'joinedAt', 'seenStreamAt'])
          && request.resource.data.uid == uid
          && request.resource.data.email == request.auth.token.email
          && cardFromProfile()
          && request.resource.data.joinedAt == request.time;
        // the stream seen, or the card brought up to date with the profile
        allow update: if isOwner(uid)
          && ((onlyChanges(['seenStreamAt']) && request.resource.data.seenStreamAt == request.time)
              || (onlyChanges(['name', 'studentId', 'section', 'contactNumber', 'photo']) && cardFromProfile()));
        // only the instructor takes a student out, never the student: the removal (removed/{uid}) and
        // its line in the record are written in this same write
        allow delete: if teaches()
          && existsAfter(removedPath(uid))
          && getAfter(removedPath(uid)).data.removedAt == request.time;
      }

      // A student the instructor took out: who, why, when, by whom, and their line in the record. The
      // student can read their own (to see they were removed, and when).
      match /removed/{uid} {
        allow get: if isOwner(uid) || teaches();
        allow list: if teaches();
        allow create: if teaches()
          && request.resource.data.keys().hasOnly(['uid', 'name', 'studentId', 'reason', 'byUid', 'logId', 'removedAt'])
          && request.resource.data.uid == uid
          && upTo(request.resource.data.name, 120)
          && upTo(request.resource.data.studentId, 40)
          && upTo(request.resource.data.reason, 300)
          && request.resource.data.byUid == request.auth.uid
          && request.resource.data.removedAt == request.time
          && request.resource.data.logId is string
          && getAfter(logPath(request.resource.data.logId)).data.type == 'removed'
          && getAfter(logPath(request.resource.data.logId)).data.studentUid == uid
          && getAfter(logPath(request.resource.data.logId)).data.at == request.time
          && !existsAfter(memberPath(uid));
        allow update: if false;
        // letting them back in, with its line in the record, named after the removal's own line
        allow delete: if teaches()
          && getAfter(logPath('readmit-' + resource.data.logId)).data.type == 'readmitted'
          && getAfter(logPath('readmit-' + resource.data.logId)).data.studentUid == uid
          && getAfter(logPath('readmit-' + resource.data.logId)).data.at == request.time;
      }

      // The class's record. The instructor (or the admin) writes a line as they act, as themselves,
      // with the server's time; nobody changes or deletes one.
      match /log/{logId} {
        allow read: if teaches();
        allow create: if teaches()
          && request.resource.data.keys().hasOnly(['type', 'byUid', 'byName', 'studentUid', 'studentName', 'studentId', 'reason', 'at'])
          && request.resource.data.type in ['removed', 'readmitted', 'ended', 'reopened']
          && request.resource.data.byUid == request.auth.uid
          && text(request.resource.data.byName, 120)
          && isMyName(request.resource.data.byName)
          && request.resource.data.at == request.time
          && upTo(request.resource.data.get('reason', ''), 300)
          && upTo(request.resource.data.get('studentName', ''), 120)
          && upTo(request.resource.data.get('studentId', ''), 40)
          && ((request.resource.data.type in ['ended', 'reopened'] && !('studentUid' in request.resource.data))
              || (request.resource.data.type in ['removed', 'readmitted'] && text(request.resource.data.get('studentUid', ''), 128)));
        allow update, delete: if false;
      }

      // the instructor posts; everyone in the class reads and comments (an ended class: reads only)
      match /posts/{postId} {
        function commentPath(id) {
          return /databases/$(database)/documents/classes/$(classId)/posts/$(postId)/comments/$(id);
        }
        allow read: if teaches() || member();
        allow create: if teaches() && !ended();
        allow delete: if teaches();
        allow update: if teaches()
          || (member() && onlyChanges(['commentCount'])
              && (request.resource.data.commentCount == resource.data.commentCount + 1
                  || request.resource.data.commentCount == resource.data.commentCount - 1))
          // who commented last, for the instructor's bell: only yourself, as yourself, pointing at
          // your own comment on this post, written in the last five minutes
          || (member() && onlyChanges(['lastCommentAt', 'lastCommentByUid', 'lastCommentByName', 'lastCommentId'])
              && request.resource.data.lastCommentAt == request.time
              && request.resource.data.lastCommentByUid == request.auth.uid
              && isMyName(request.resource.data.lastCommentByName)
              && request.resource.data.lastCommentId is string
              && get(commentPath(request.resource.data.lastCommentId)).data.authorUid == request.auth.uid
              && request.time < get(commentPath(request.resource.data.lastCommentId)).data.createdAt + duration.value(5, 'm'));

        match /comments/{commentId} {
          allow read: if teaches() || member();
          // as yourself; only the instructor's comments carry the Instructor badge
          allow create: if (teaches() || member())
            && !ended()
            && request.resource.data.keys().hasOnly(['text', 'authorUid', 'authorName', 'fromInstructor', 'createdAt'])
            && request.resource.data.authorUid == request.auth.uid
            && text(request.resource.data.text, 2000)
            && text(request.resource.data.authorName, 120)
            && isMyName(request.resource.data.authorName)
            && request.resource.data.fromInstructor == teaches()
            && request.resource.data.createdAt == request.time;
          allow update: if false;
          // your own, while the class runs (an ended class is a record)
          allow delete: if teaches() || (signedIn() && resource.data.authorUid == request.auth.uid && !ended());
        }
      }

      // There are no private messages in a class (instructors and students use their own
      // messenger): the old conversations, classes/{classId}/threads/..., match no rule, so nobody
      // can read or write them.
    }

    match /userClasses/{uid}/classes/{classId} {
      allow read, write: if isOwner(uid);
    }

    // ---------- sign-ins (src/lab/SignIns.js) ----------

    // Each sign-in: who, when (the server's clock), where from (as the person's internet connection
    // gives it away) and on what. Written by the person signing in, as they do, together with their
    // latest in signInLast/{uid}: at most one a minute, so nobody can flood the log. Only the admin
    // reads them, and nobody, the admin neither, changes or deletes one.

    function signInEntry(d) {
      return d.keys().hasOnly(['uid', 'email', 'at', 'ip', 'city', 'region', 'country', 'countryCode', 'lat', 'lon', 'isp', 'ipTimezone', 'device', 'timezone'])
        && d.keys().hasAll(['uid', 'email', 'at', 'ip', 'city', 'region', 'country', 'countryCode', 'lat', 'lon', 'isp', 'ipTimezone', 'device', 'timezone'])
        && d.uid == request.auth.uid
        && d.email == request.auth.token.email
        && d.at == request.time
        && upTo(d.ip, 45) && upTo(d.city, 80) && upTo(d.region, 80) && upTo(d.country, 60)
        && d.countryCode is string && (d.countryCode == '' || d.countryCode.matches('^[A-Z]{2}$'))
        && (d.lat == null || (d.lat is number && d.lat >= -90 && d.lat <= 90))
        && (d.lon == null || (d.lon is number && d.lon >= -180 && d.lon <= 180))
        && upTo(d.isp, 120) && upTo(d.ipTimezone, 60)
        && text(d.device, 80) && upTo(d.timezone, 60);
    }

    match /signIns/{id} {
      allow read: if isAdmin();
      allow create: if signedIn() && signInEntry(request.resource.data)
        && getAfter(/databases/$(database)/documents/signInLast/$(request.auth.uid)).data.id == id;
      allow update, delete: if false;
    }

    // The same record, with its id; written only alongside it
    match /signInLast/{uid} {
      allow read: if isAdmin();
      allow create, update: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.at == request.time
        && request.resource.data.id is string
        && request.resource.data.diff(getAfter(/databases/$(database)/documents/signIns/$(request.resource.data.id)).data).affectedKeys().hasOnly(['id'])
        && (resource == null || request.time > resource.data.at + duration.value(60, 's'));
      allow delete: if false;
    }

    // ---------- everything else ----------
    // Add your other collections (AR models, etc.) above this line. Anything not listed is denied.
  }
}
